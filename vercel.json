{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "node -e \"console.log('Modular POS zero-dependency install complete')\"",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/login",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/account.html"
    },
    {
      "source": "/pos",
      "destination": "/account.html"
    },
    {
      "source": "/",
      "destination": "/account.html"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/account.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
