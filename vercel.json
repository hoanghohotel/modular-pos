{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "node -e \"console.log('Modular POS zero-dependency install complete')\"",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/pos",
      "destination": "/index.html"
    },
    {
      "source": "/kds",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
